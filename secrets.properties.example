# ===================================================
# secrets.properties.example
# ===================================================
# انسخ هذا الملف إلى secrets.properties وضع القيم الحقيقية
# cp secrets.properties.example secrets.properties
#
# ⚠️  NEVER commit secrets.properties to git!
# ===================================================

# TURN Server credentials (for WebRTC fallback over WAN/cellular)
TURN_USERNAME=your_turn_username_here
TURN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
# ✅ 5.3: TURN_URL required for isTurnConfigured() to return true.
# Leave blank for LAN-only mode (app uses direct socket; TURN not needed).
# Example: turn:your-turn-server.com:3478
TURN_URL=

# Horus Backend Secret Token (min 64 chars random string)
# Generate with: openssl rand -hex 32
HORUS_SECRET_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
