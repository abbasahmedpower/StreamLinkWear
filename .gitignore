# ====================================================================
#  🌌 STREAMLINKWEAR — THE ULTIMATE GOD-MODE .gitignore IN THE WORLD
# ====================================================================
# مصمم خصيصاً لحماية الكود، توفير المساحة، ومنع الأخطاء البرمجية نهائياً.

# ── 🎯 1. طلباتك الخاصة والصارمة (Custom Top-Priority Rules) ────────
project_for_review.zip
temp_upload/
**/temp_upload/
*.zip
*.rar
*.7z

# ── 🤖 2. أدوات الذكاء الاصطناعي والمحررات الحديثة (AI & Next-Gen Tools) ──
.cursor/
.continue/
.copilot/
.fide/
.yoyo/
testsprite_tests/tmp/config.json

# ── ⚙️ 3. مخرجات بناء أندرويد والملفات الثقيلة (Android & Gradle Engine) ──
.gradle/
build/
*/build/
**/build/
bin/
*/bin/
**/bin/
buildSrc/build/
.navigation/
captures/
*.hprof
local.properties
.kotlin/

# ── 📦 4. حزم التطبيقات المستخرجة (No Compiled Apps Allowed) ─────────
*.apk
*.aab
*.ap_
*.dex
*.class

# ── 🔑 5. جدار الحماية الأمني للمفاتيح والسرية (Cybersecurity & Secrets) ──
*.jks
*.keystore
*.p12
*.pkcs12
*.pem
*.key
keystore.properties
signing.properties
secrets.properties
.env
.env.local
.env.*.local

# ── 💻 6. بيئات التطوير (Android Studio / IntelliJ / VS Code) ───────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── 🛡️ 7. ملفات النظام المخفية (OS-Specific Micro Dust - Win/Mac/Linux) ──
# نظام ماك (macOS)
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes

# نظام ويندوز (Windows)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# نظام لينكس (Linux)
*~
.fuse_hidden*
.directory
.trash

# ── 📊 8. السجلات والتقارير والملفات المؤقتة (Logs & Diagnostics) ─────
# JVM Crash Dumps & KSP Errors
hs_err_pid*.log
replay_pid*.log
ksp_error.txt
ksp_stacktrace.txt
build_*.txt
test_output.txt
*.log
logs/
log/
crash_reports/
.attach_pid*

# ── 🗄️ 9. قواعد البيانات والملفات المؤقتة للمشغل (Databases & Cache) ──
*.db
*.sqlite
*.sqlite3
.m2/
.recommenders/

# ── 🛠️ 10. استثناءات ذكية (The Holy Whitelist - نظام تشغيل الـ Wrapper) ──
# بنقول لجيت: "سيب دول في حالهم واحميهم لأنهم مهمين لتشغيل المشروع فوراً"
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat 
#ملقات االاختبارات 
google-services.json
google-services(1).json
# Ignore GitLeaks local tool
gitleaks_tool/
gitleaks.exe
